                                                                               eys
                      52            
                      53            ; Check if this key is different from last displayed
0157 E506             54            MOV     A, 06H          ; Get current key
0159 B50702           55            CJNE    A, 07H, DISPLAY_NEW  ; If different from last displayed
015C 80E4             56            SJMP    MAIN            ; Same key, don't display again
