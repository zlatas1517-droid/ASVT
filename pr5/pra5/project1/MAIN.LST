015E                  58    DISPLAY_NEW:
                      59            ; Display the digit on LCD
015E E506             60            MOV     A, 06H          ; Get current key
0160 F580             61            MOV     P0, A           ; Send the digit to LCD
0162 75A003           62            MOV     P2, #3          ; Set RS=1, RW=0, EN=1
0165 75A002           63            MOV     P2, #2          ; Set RS=1, RW=0, EN=0 (latch data)
0168 1201EF           64            LCALL   DELAY_SHORT     ; Short delay only
                      65            
016B F507             66            MOV     07H, A          ; Store as last displayed key
