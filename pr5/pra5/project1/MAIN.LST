0172                  72    GET_KEY:
                      73            ; Scan all rows and return the highest priority key (lower row has higher priority)
                                                                               
                      74            ; Returns key ASCII code in A, or 0FFH if no key pressed
                      75            
                      76            ; Row 0 (P1.0 = 0) - Highest priority
